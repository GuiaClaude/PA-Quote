# ─── Database ────────────────────────────────────────────────────────────────
# Postgres connection string. On Supabase: Project Settings → Database →
# Connection string → "Transaction pooler" (port 6543). Locally: your own Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pa_finance

# ─── Auth ────────────────────────────────────────────────────────────────────
# "dev"      = pick a demo user on the login page (local preview only, never in production)
# "supabase" = real email/password + Google sign-in through Supabase Auth (Phase 1 deploy)
AUTH_MODE=dev
# Long random string used to sign session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Supabase (needed when AUTH_MODE=supabase) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Later phases ────────────────────────────────────────────────────────────
TOKEN_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
