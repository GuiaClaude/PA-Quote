# ── PA Billing environment template ── copy to .env (never commit real values)

# Server
PORT=8080
APP_BASE_URL=https://billing.example.com          # public URL; used for the OAuth redirect
COOKIE_SECURE=true                                 # false only for local http development
SESSION_TTL_HOURS=12

# PostgreSQL (14+)
DATABASE_URL=postgres://pa_billing:CHANGE_ME@db-host:5432/pa_billing

# 32 random bytes, hex (64 chars). Encrypts the Google refresh token at rest.
#   generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://billing.example.com/api/google/oauth/callback

# Scheduling
ENABLE_INTERNAL_SCHEDULER=true       # in-process Monday 08:00 Asia/Manila run (+ sync/report jobs)
CRON_SECRET=                         # set if an external scheduler calls POST /api/cron/monday (header x-cron-secret)

# Demo databases only — never set on production
# SAMPLE_MODE=true
