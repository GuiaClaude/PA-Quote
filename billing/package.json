{
  "name": "pa-billing",
  "private": true,
  "version": "0.1.0",
  "description": "Print Amplified OPC - Job Order Control, Billing, AR, SOA and Collection System",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "migrate": "node server/cli/migrate.js",
    "user:create": "node server/cli/createUser.js",
    "collection:run": "node server/cli/runCollection.js",
    "sync:run": "node server/cli/runSync.js",
    "seed:sample": "node server/cli/seedSample.js",
    "test": "node --test --test-concurrency=1 'server/test/**/*.test.js'"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "croner": "^10.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "googleapis": "^185.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21"
  }
}
