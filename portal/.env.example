# =============================================================================
# Print Amplified ordering app — settings that live OUTSIDE the database.
# Copy this file to .env.local (for your computer) and fill in the values.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# NEVER commit .env.local or share the SECRET key.
# =============================================================================

# --- Supabase (database, logins, file storage) -------------------------------
# Supabase dashboard → Project Settings → API (or "API Keys").
# The project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The PUBLISHABLE key (starts with sb_publishable_…; older projects call it the
# "anon" key). Safe to show in the browser: the database's security rules (RLS)
# decide what each signed-in user can see.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The SECRET key (starts with sb_secret_…; older projects: "service_role").
# Full access — server only. Used to create logins from invites, write the audit
# log and sign people out. Never put NEXT_PUBLIC_ in front of this name.
SUPABASE_SECRET_KEY=

# --- The app's own web address ------------------------------------------------
# Used in email links (invites, sign-in links). No trailing slash.
# Local: http://localhost:3000   Live: https://order.printamplified.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Device recognition -------------------------------------------------------
# Any long random text (40+ characters). Used to recognise devices without
# storing their ids. Generate one with:  openssl rand -base64 48
DEVICE_HASH_SECRET=

# --- Cloudflare Turnstile (anti-bot check on sign-in forms) — FREE ------------
# Cloudflare dashboard → Turnstile → Add site. The SITE key goes here; the
# SECRET key goes into Supabase → Authentication → Attack Protection → CAPTCHA.
# Leave empty on your computer to skip the check while developing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Resend (notification emails) — free up to 3,000 emails/month -------------
# resend.com → API Keys. Leave empty locally: emails are printed in the
# terminal instead of being sent.
RESEND_API_KEY=
# Fallback sender (the one in Settings → Email sender is used when set).
EMAIL_FROM="Print Amplified <orders@order.printamplified.com>"

# --- Claude API (OPTIONAL, paid per use) -------------------------------------
# Only needed for "Auto-fill from file" on past estimates. Leave empty to keep
# it off. It also has to be switched on in Settings → Optional features.
# console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=

# --- Only for automated tests -------------------------------------------------
# Local plain-Postgres test database used by `npm run test:rls`.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pa_test
# A Supabase project loaded with the DEMO seed, for `npm run test:api`.
# Never point these at the live project.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
